{
  "name": "aro-publication-navigator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive A\u2013Z companion for publishing Kurdish tokenizer research in ARO, The Scientific Journal of Koya University.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "check:links": "node scripts/check-links.mjs",
    "serve": "python3 -m http.server 4173",
    "test:e2e": "python3 tests/e2e.py http://localhost:4173",
    "screenshots": "python3 tests/shoot.py http://localhost:4173 qa/screenshots"
  }
}
